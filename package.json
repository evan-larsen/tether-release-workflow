{
  "name": "tether-release-workflow",
  "version": "1.0.0",
  "description": "Tether release-workflow Supabase Edge Function.",
  "scripts": {
    "lint": "deno lint --config supabase/functions/release-workflow/deno.json supabase/functions",
    "test": "deno test --config supabase/functions/release-workflow/deno.json --allow-env --allow-net supabase/functions/release-workflow/tests",
    "format": "prettier --write . --cache --cache-location .cache/prettier --log-level warn",
    "format:check": "prettier --check .",
    "contract:parity": "node ../tether-app/scripts/release-cli/verifyContractParity.js --strict --app-root ../tether-app --edge-root .",
    "check": "npm run lint && npm run test && npm run format:check",
    "supabase:status": "supabase status",
    "supabase:serve": "supabase functions serve release-workflow --env-file .env.local",
    "supabase:deploy": "supabase functions deploy release-workflow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evan-larsen/tether-release-workflow.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/evan-larsen/tether-release-workflow/issues"
  },
  "homepage": "https://github.com/evan-larsen/tether-release-workflow#readme",
  "private": true,
  "devDependencies": {
    "deno": "^2.9.4",
    "prettier": "^3.8.1",
    "supabase": "^2.110.0"
  }
}
